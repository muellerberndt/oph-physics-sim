.DS_Store
__pycache__/
.pytest_cache/

# Local secrets and machine-specific cloud settings.
.env
.env.*
!.env.example
*.tfvars
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
credentials/
secrets/

# Local correspondence and handoff scratch space.
correspondence/

# Local/generated run configs. Curated examples stay tracked under configs/.
configs/local/
configs/generated/
configs/*.local.yml
configs/*.local.yaml
configs/*.local.toml
configs/*.private.yml
configs/*.private.yaml
configs/*.private.toml
configs/*.tmp.yml
configs/*.tmp.yaml
configs/*.tmp.toml

# Generated artifacts and simulation run data.
# Keep these local-only trees out of Git, including dated run folders.
artifacts/
receipts/
runs/
run/
data/runs/
data/earned_runs/
distributed/
temp/
.oph_fpe_cache/
*.log
*.jsonl

# Generated display-only visualizer exports and upload archives.
visualizer_handoffs/
visualizer_bundles/

# Empirical run outputs are retained locally or in external receipt archives.
